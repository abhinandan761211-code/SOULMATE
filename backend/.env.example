# Copy to .env and fill in your own values. Never commit .env.
# SECRET values — these must never reach the browser or the repo.

# --- Supabase ---------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
# service_role key: the API runs with full database access, so it scopes every
# query by the signed-in user id itself.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# optional fallback for local dev if you only have the public key
SUPABASE_ANON_KEY=your-anon-public-key

# --- Google OAuth (stays server-side) ---------------------------------------
# Paste the client ID + secret into Supabase Dashboard > Authentication >
# Providers > Google. The API only needs them if you add a Google call here.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# --- CORS -------------------------------------------------------------------
# Comma-separated. Add your Netlify URL after the first deploy.
CORS_ORIGINS=http://localhost:5199,https://your-app.netlify.app

ENVIRONMENT=development
